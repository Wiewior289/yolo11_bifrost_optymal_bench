diff --git a/src/layer/vulkan/convolution_vulkan.cpp b/src/layer/vulkan/convolution_vulkan.cpp
--- a/src/layer/vulkan/convolution_vulkan.cpp
+++ b/src/layer/vulkan/convolution_vulkan.cpp
@@ -1473,6 +1473,38 @@
         }
 
         pipeline_convolution = new Pipeline(vkdev);
+#if defined(NCNN_CONV_DIRECT_LOCAL_SIZE_X) && defined(NCNN_CONV_DIRECT_LOCAL_SIZE_Y) && defined(NCNN_CONV_DIRECT_LOCAL_SIZE_Z)
+        // Experimental fixed workgroup dimensions for the packed generic Direct Convolution shader.
+        // It indexes gl_GlobalInvocationID and has explicit output bounds checks.
+        const unsigned int direct_local_x = NCNN_CONV_DIRECT_LOCAL_SIZE_X;
+        const unsigned int direct_local_y = NCNN_CONV_DIRECT_LOCAL_SIZE_Y;
+        const unsigned int direct_local_z = NCNN_CONV_DIRECT_LOCAL_SIZE_Z;
+        const unsigned long long direct_local_invocations =
+            (unsigned long long)direct_local_x * direct_local_y * direct_local_z;
+        const bool direct_local_size_supported =
+            direct_local_x <= vkdev->info.max_workgroup_size_x() &&
+            direct_local_y <= vkdev->info.max_workgroup_size_y() &&
+            direct_local_z <= vkdev->info.max_workgroup_size_z() &&
+            direct_local_invocations <= vkdev->info.max_workgroup_invocations();
+        if (direct_local_size_supported)
+        {
+            pipeline_convolution->set_local_size_xyz(direct_local_x, direct_local_y, direct_local_z);
+            NCNN_LOGE("[CONV_DIRECT_LOCAL_SIZE] requested=%ux%ux%u applied=%ux%ux%u invocations=%llu",
+                      direct_local_x, direct_local_y, direct_local_z,
+                      pipeline_convolution->local_size_x(), pipeline_convolution->local_size_y(),
+                      pipeline_convolution->local_size_z(), direct_local_invocations);
+        }
+        else
+        {
+            NCNN_LOGE("[CONV_DIRECT_LOCAL_SIZE] requested=%ux%ux%u exceeds Vulkan limits max_size=%ux%ux%u max_invocations=%u; fallback=optimal",
+                      direct_local_x, direct_local_y, direct_local_z,
+                      vkdev->info.max_workgroup_size_x(), vkdev->info.max_workgroup_size_y(),
+                      vkdev->info.max_workgroup_size_z(), vkdev->info.max_workgroup_invocations());
+            pipeline_convolution->set_optimal_local_size_xyz(local_size_xyz);
+        }
+#else
+        pipeline_convolution->set_optimal_local_size_xyz(local_size_xyz);
+#endif
         pipeline_convolution->create(LayerShaderType::convolution_packed, opt, specializations);
     }
 
